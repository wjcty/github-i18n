generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  githubId              String?   @unique
  login                 String
  name                  String?
  avatarUrl             String?
  primaryEmail          String?
  emailVerified         Boolean   @default(false)
  encryptedAccessToken  String?   @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenExpiresAt        DateTime?
  keyVersion            Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  settings     UserSettings?
  repositories Repository[]
  usageRecords UsageRecord[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  userId              String   @id
  billingMode         String   @default("BYOK")
  openrouterKeyEnc    String?  @db.Text
  defaultModelId      String   @default("openai/gpt-4o-mini")
  defaultTargetLangs  Json     @default("[]")
  platformCharUsed    Int      @default(0)
  platformCharResetAt DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Installation {
  id                  String   @id @default(cuid())
  installationId      Int      @unique
  accountLogin        String
  accountType         String
  repositorySelection String?
  updatedAt           DateTime @updatedAt

  repositories Repository[]
}

model Repository {
  id                       String    @id @default(cuid())
  userId                   String
  installationId           Int
  installationRecordId     String?
  githubRepoId             Int
  owner                    String
  name                     String
  fullName                 String
  defaultBranch            String    @default("main")
  baseLanguage             String    @default("zh-CN")
  targetLanguages          Json      @default("[]")
  scopeConfig              Json      @default("{\"mode\":\"paths\",\"includePaths\":[\"README.md\"],\"excludePaths\":[]}")
  ignoreFileContent        String?   @db.Text
  lastTranslatedBaseCommit String?
  autoSyncEnabled          Boolean   @default(true)
  treeCache                Json?
  treeCachedAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation Installation?     @relation(fields: [installationRecordId], references: [id])
  tasks        TranslationTask[]
  previews     TaskPreview[]

  @@unique([userId, githubRepoId])
  @@index([installationId, fullName])
}

model TranslationTask {
  id                String    @id @default(cuid())
  repositoryId      String
  status            String    @default("pending")
  mode              String
  trigger           String    @default("manual")
  webhookDeliveryId String?
  targetLanguages   Json
  totalFiles        Int       @default(0)
  doneFiles         Int       @default(0)
  currentFile       String?
  skipReason        String?
  errorMessage      String?   @db.Text
  prUrl             String?
  prNumber          Int?
  headBranch        String?
  headCommitSha     String?
  retryCount        Int       @default(0)
  afterCommit       String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  jobs       Job[]
  previews   TaskPreview[]
  usage      UsageRecord[]

  @@index([repositoryId, createdAt])
}

model TaskPreview {
  id             String @id @default(cuid())
  taskId         String
  repositoryId   String
  lang           String
  sourcePath     String
  translatedPath String
  content        String @db.LongText

  task       TranslationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repository Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([taskId, lang, sourcePath])
}

model WebhookDelivery {
  deliveryId   String   @id
  event        String
  repoFullName String?
  processedAt  DateTime @default(now())
}

model Job {
  id        String    @id @default(cuid())
  taskId    String
  status    String    @default("pending")
  payload   Json?
  attempts  Int       @default(0)
  lockedAt  DateTime?
  runAt     DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task TranslationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  charsIn   Int      @default(0)
  charsOut  Int      @default(0)
  model     String?
  source    String
  createdAt DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task TranslationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}
