# MySQL（请改为你本机 root 密码）
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/github_i18n

PORT=3123
# 前端 web 在 3001、/api 反代到本后端时，OAuth 使用浏览器地址 3001
APP_URL=http://localhost:3001
AUTH_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=任意足够长的随机字符串

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 私钥文件路径（相对项目根目录），文件名为 private-key.pem
GITHUB_APP_PRIVATE_KEY=./private-key.pem
GITHUB_APP_WEBHOOK_SECRET=

# 平台 OpenRouter（可选；BYOK 用户在 Settings 页配置）
PLATFORM_OPENROUTER_API_KEY=
